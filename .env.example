# Display-only name. Change this to rebrand without touching application code.
APP_DISPLAY_NAME=PayMender
APP_ENV=development
DEMO_MODE=true
DATABASE_URL=sqlite:///./paymender.sqlite3

# Required for command-center APIs. Generate a random value of at least 24 characters.
OPERATOR_API_TOKEN=
MAX_WEBHOOK_BODY_BYTES=262144
WEBHOOK_RATE_LIMIT_PER_MINUTE=60
OPERATOR_SESSION_RATE_LIMIT_PER_15_MINUTES=10
EVALUATION_RATE_LIMIT_PER_MINUTE=2
RATE_LIMIT_MAX_KEYS=10000

# Gemini: keep the real value only in .env.local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MAX_OUTPUT_TOKENS=512

# Razorpay test-mode credentials only. Live keys are rejected by the app.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test
RAZORPAY_PAYMENT_LINK_HOSTS=rzp.io
MAX_REAL_PAYMENT_LINKS=5

# Single-worker submission configuration.
JOB_LEASE_SECONDS=60
